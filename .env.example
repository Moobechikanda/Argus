# ============================================================================
# Supabase — variáveis públicas (podem ir pro frontend)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua-anon-key-aqui

# ============================================================================
# Supabase — credenciais de workers (somente no ambiente do serviço respectivo)
# NUNCA expor no frontend, NUNCA commitar no git
# ============================================================================
# Direct database logins created by migration 20261031000001. Set strong,
# distinct passwords out of band and grant no other database role memberships.
# Set strong, distinct passwords out of band; never use postgres or
# service-role credentials. The login roles are not granted membership in any
# elevated role.
SUPABASE_IMPORT_WORKER_DB_URL=postgresql://reconciliation_import_worker:SET_OUT_OF_BAND@YOUR_DB_HOST:5432/postgres
SUPABASE_MATCHING_WORKER_DB_URL=postgresql://reconciliation_matching_worker:SET_OUT_OF_BAND@YOUR_DB_HOST:5432/postgres

# ============================================================================
# Configuração do template (opcional)
# ============================================================================
# Se "true", criar uma empresa automaticamente quando o usuário fizer signup
# (o usuário vira owner dessa empresa).
# Se "false", o usuário precisa ser convidado para uma empresa existente.
TEMPLATE_AUTO_CREATE_COMPANY_ON_SIGNUP=true

# Tempo de expiração de convites (em horas). Padrão: 168 (7 dias)
TEMPLATE_INVITATION_EXPIRY_HOURS=168

# ============================================================================
# Email (para envio de convites via Edge Function)
# ============================================================================
# Usando Resend (https://resend.com) — recomendado pela facilidade
RESEND_API_KEY=re_...
INVITATION_FROM_EMAIL=convites@seudominio.com.br
INVITATION_FROM_NAME=Seu App
